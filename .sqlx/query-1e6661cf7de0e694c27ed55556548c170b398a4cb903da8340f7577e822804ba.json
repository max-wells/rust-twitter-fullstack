{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    u.id,\n                    u.username,\n                    u.display_name,\n                    u.bio,\n                    u.avatar_url,\n                    u.banner_url,\n                    u.created_at,\n                    EXISTS(\n                        SELECT 1 FROM follows\n                        WHERE follower_id = $2 AND following_id = u.id\n                    ) AS \"is_following!: bool\",\n                    (u.id = $2) AS \"is_current_user!: bool\"\n                FROM users u\n                WHERE u.username = $1\n                ",
