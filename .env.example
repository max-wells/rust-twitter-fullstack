POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=twitter_clone_fullstack

# SQLx migrations specifically look for the DATABASE_URL environment variable by convention.
# For local development (Postgres on localhost):
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1/${POSTGRES_DATABASE}

# When running with docker-compose, DATABASE_URL is overridden by docker-compose.yml
# to point at the `db` service:
# DATABASE_URL=postgres://postgres:password@db:5432/twitter_clone_fullstack
